{
  "name": "craftgrn-thesis-presentation",
  "private": true,
  "version": "1.0.0",
  "description": "Static Reveal.js thesis presentation",
  "scripts": {
    "renderer:build": "docker build -f tools/Dockerfile.renderer -t craftgrn-presentation-renderer:ubuntu24.04-lo24.2.7-poppler24.02.0 tools",
    "build": "python3 tools/build_presentation.py",
    "build:site": "python3 tools/build_presentation.py --skip-render",
    "test:unit": "python3 -m unittest tests.test_build_presentation -v",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "reveal.js": "6.0.1"
  }
}
